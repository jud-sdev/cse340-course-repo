<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

    <p><strong>Categories:</strong>
        <% categories.forEach(category => { %>
            <a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
        <% }); %>
    </p>

    <% if (user) { %>
        <% if (isVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <p><a href="/project/<%= project.project_id %>/remove-volunteer">Remove me from this project</a></p>
        <% } else { %>
            <p><a href="/project/<%= project.project_id %>/volunteer">Volunteer for this project</a></p>
        <% } %>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
